---
/**
 * An architecture map drawn with the page's own type and hairlines, not an
 * image: boxes grouped in tiers, top to bottom, the way a request travels.
 * Each tier is a ruled container with its label; a tier can also hold a
 * chain (a row of boxes that hand off to one another, like the containers
 * on one machine) before its loose boxes. Between tiers, a labelled
 * connector says what crosses. Text reflows, so the map reads at phone
 * width and on either tone, where an SVG with 12px labels would not.
 */
import Arrow from "@/components/hero/Arrow.astro"
import type { DiagramBlock } from "@/data/writeups"
import type { Lang } from "@/i18n/ui"

interface Props {
  lang: Lang
  block: DiagramBlock
}

const { lang, block } = Astro.props
---

<div class="map" role="group" aria-label={block.alt[lang]}>
  {block.tiers.map((tier, i) => (
    <>
      {i > 0 && (
        <p class="map-link meta">
          <Arrow dir="download" />
          <span>{block.links[lang][i - 1]}</span>
        </p>
      )}
      <section class="map-tier" aria-label={tier.label[lang]}>
        <p class="meta map-label">{tier.label[lang]}</p>
        {tier.chain && (
          <div class="map-chain">
            <p class="meta map-label">{tier.chain.label[lang]}</p>
            <ol class="map-row map-row-chain">
              {tier.chain.boxes.map((box, b) => (
                <li class="map-box">
                  {b > 0 && (
                    <span class="map-arrow" aria-hidden="true">
                      <Arrow dir="email" />
                    </span>
                  )}
                  <span class="meta-name map-name">{box.name}</span>
                  <span class="map-note">{box.note[lang]}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
        <ul class="map-row">
          {tier.boxes.map((box) => (
            <li class="map-box">
              <span class="meta-name map-name">{box.name}</span>
              <span class="map-note">{box.note[lang]}</span>
            </li>
          ))}
        </ul>
      </section>
    </>
  ))}
</div>

<style>
  .map {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .map-tier {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--rule);
  }

  .map-label {
    color: var(--title-color);
  }

  .map-link {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding-inline: 1rem;
    color: var(--text-muted);
  }

  .map-chain {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--rule);
  }

  .map-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .map-box {
    position: relative;
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--rule);
  }

  .map-name {
    color: var(--title-color);
  }

  .map-note {
    font-size: 0.875rem;
    line-height: 1.4;
    letter-spacing: var(--tracking-body);
    text-wrap: pretty;
  }

  /* The hand-off between two boxes of a chain: an arrow on the shared edge. */
  .map-arrow {
    position: absolute;
    top: -1.1rem;
    left: 50%;
    transform: translateX(-50%) rotate(90deg);
    padding: 0 0.2em;
    color: var(--title-color);
    line-height: 1;
  }

  @media (width >= 40rem) {
    .map-row-chain {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .map-arrow {
      top: 50%;
      left: -0.95rem;
      transform: translateY(-50%);
    }
  }
</style>
