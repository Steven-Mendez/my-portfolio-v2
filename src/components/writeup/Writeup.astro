---
/**
 * A project's write-up, laid out like a blog post. On ink, the opening is
 * a cover spread: on the left the kicker (Work, track number, reading
 * time), the project's name as the h1 and the lead; on the right, wider,
 * the cover: the project's video (played in place) or one screen of it,
 * set as a plate with rounded corners; under both, one ruled
 * line of facts (year, role, stack, links) in four cells.
 * Then, on paper, one centred 42rem reading column: each
 * chapter's number and heading sit in the column above its blocks.
 * Screenshots and clips are plates; a run of two or more is one carousel
 * and a phone recording reads beside its caption. Plates are numbered in
 * reading order across the page.
 * The last row, back on ink, points to the neighbouring write-up and back
 * to the list.
 *
 * Motion hooks are the shared ones: data-reveal on blocks, `items` on
 * lists, `rows` + data-build on the spec sheets, data-draw on the rule.
 */
import { getImage, Picture } from "astro:assets"
import BracketLink from "@/components/hero/BracketLink.astro"
import Diamond from "@/components/hero/Diamond.astro"
import StackLine from "@/components/sections/StackLine.astro"
import Carousel from "./Carousel.astro"
import Plate from "./Plate.astro"
import YouTube from "./YouTube.astro"
import { projects } from "@/data/projects"
import {
  readingMinutes,
  writeupPath,
  writeups,
  type Block,
  type Writeup,
} from "@/data/writeups"
import { formatMonth } from "@/i18n/dates"
import type { Lang } from "@/i18n/ui"
import { emphasis, fill, getLocalizedPath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Lang
  writeup: Writeup
}

const { lang, writeup } = Astro.props
const t = useTranslations(lang)

const position = projects.findIndex((p) => p.slug === writeup.slug)
if (position < 0) throw new Error(`No project for write-up: ${writeup.slug}`)
const project = projects[position]!
// The track number in the Work list, so the watermark matches the list.
const index = String(position + 1).padStart(2, "0")
const two = (n: number) => String(n).padStart(2, "0")

const note = fill(t("writeup.readingTime"), {
  min: readingMinutes(writeup, lang),
})

// The cover: the write-up's own, or else its first screenshot.
const firstFigure = writeup.chapters
  .flatMap((chapter) => chapter.blocks)
  .find((block) => block.type === "figure")
const cover: NonNullable<Writeup["cover"]> | undefined =
  writeup.cover ??
  (firstFigure && { image: firstFigure.image, alt: firstFigure.alt })
if (!cover) throw new Error(`No cover for write-up: ${writeup.slug}`)
// Seven of twelve columns on lg (the page measure is 100rem), full width below.
const coverSizes = "(min-width: 64rem) min(56rem, 56vw), calc(100vw - 2rem)"
// A screenshot cover opens in the lightbox at its own size, like the plates.
const coverFull = cover.youtube
  ? undefined
  : await getImage({
      src: cover.image,
      format: "webp",
      width: Math.min(cover.image.width, 2400),
    })
const updated = fill(t("writeup.updated"), {
  date: formatMonth(writeup.updated, lang),
})

// A screenshot borrowed as the cover is not shown again in the body.
const body = (blocks: readonly Block[]) =>
  writeup.cover ? blocks : blocks.filter((block) => block !== firstFigure)

// Figures are numbered across the page in reading order.
const figures = new Map<Block, number>()
for (const chapter of writeup.chapters)
  for (const block of body(chapter.blocks))
    if (
      block.type === "figure" ||
      block.type === "clip" ||
      block.type === "diagram"
    )
      figures.set(block, figures.size + 1)

// A run of two or more landscape plates (screenshots or wide clips) reads
// as one carousel; a phone recording or a lone plate stands on its own.
type PlateBlock = Extract<Block, { type: "figure" | "clip" }>
type AsideBlock = Extract<Block, { type: "p" | "list" }>
type Item =
  | Block
  | { type: "carousel"; slides: PlateBlock[] }
  | { type: "aside"; plate: PlateBlock; text: AsideBlock[] }
const isSlide = (block: Block): block is PlateBlock =>
  block.type === "figure" ||
  (block.type === "clip" && block.width >= block.height)
const isPortrait = (block: Block): block is PlateBlock =>
  block.type === "clip" && block.height > block.width
function group(blocks: readonly Block[]): Item[] {
  const items: Item[] = []
  let run: PlateBlock[] = []
  const flush = () => {
    if (run.length > 1) items.push({ type: "carousel", slides: run })
    else items.push(...run)
    run = []
  }
  for (let i = 0; i < blocks.length; i++) {
    const block = blocks[i]!
    if (isSlide(block)) {
      run.push(block)
      continue
    }
    flush()
    if (isPortrait(block)) {
      // A phone is tall and narrow: the text that follows reads beside it.
      const text: AsideBlock[] = []
      const next = () => blocks[i + 1]?.type
      while (text.length < 3 && (next() === "p" || next() === "list"))
        text.push(blocks[++i] as AsideBlock)
      items.push(text.length ? { type: "aside", plate: block, text } : block)
      continue
    }
    items.push(block)
  }
  flush()
  return items
}

// Neighbours in the order of the Work list.
const order = projects
  .map((p) => p.slug)
  .filter((slug) => writeups.some((w) => w.slug === slug))
const at = order.indexOf(writeup.slug)
const neighbour = (slug: string | undefined) =>
  slug
    ? {
        title: projects.find((p) => p.slug === slug)!.title,
        href: getLocalizedPath(lang, writeupPath(slug)),
      }
    : undefined
const previous = neighbour(order[at - 1])
const next = neighbour(order[at + 1])
const allWork = `${getLocalizedPath(lang).replace(/\/?$/, "/")}#work`
---

<article class="writeup" aria-labelledby="writeup-title">
  <header class="writeup-open px-gutter pt-36 pb-section sm:px-6 lg:px-12 lg:pt-40">
    <div class="dots-layer" aria-hidden="true"></div>
    <div class="shell writeup-masthead">
      <div class="writeup-copy">
        {/* What it is and how long, the title, the lead. */}
        <p class="meta writeup-kicker" data-reveal>
          <Diamond size={9} />
          <span>
            {t("nav.work")} {index}
          </span>
          <span aria-hidden="true">·</span>
          <span>{note}</span>
        </p>
        <h1 id="writeup-title" class="writeup-title type-display" data-reveal>
          {project.title}
        </h1>
        <p class="writeup-lead type-lead" data-reveal>
          {writeup.lead[lang]}
        </p>
      </div>

      {/* The cover: the project's video, or one screen of it, as a plate. */}
      <div class="writeup-cover" data-reveal>
        {cover.youtube ? (
          <YouTube
            id={cover.youtube}
            poster={cover.image}
            alt={cover.alt[lang]}
            label={t("writeup.play")}
            duration={cover.duration}
            sizes={coverSizes}
          />
        ) : (
          <Picture
            src={cover.image}
            alt={cover.alt[lang]}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[720, 1080, 1440]}
            sizes={coverSizes}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="writeup-cover-img"
          />
        )}
        {coverFull && (
          <button
            type="button"
            class="cover-zoom"
            aria-label={t("writeup.zoom")}
            data-zoom="image"
            data-zoom-src={coverFull.src}
            data-zoom-alt={cover.alt[lang]}
          >
            <svg
              class="cover-zoom-icon"
              viewBox="0 0 12 12"
              width="12"
              height="12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M7.5 1.5h3v3M10.5 1.5 7 5M4.5 10.5h-3v-3M1.5 10.5 5 7"></path>
            </svg>
          </button>
        )}
      </div>

      {/* The facts of the project, on one ruled line. */}
      <dl class="writeup-spec" data-reveal="items">
        <div class="spec-cell">
          <dt class="meta">{t("writeup.year")}</dt>
          <dd class="meta-name tabular-nums">{project.year}</dd>
        </div>
        <div class="spec-cell">
          <dt class="meta">{t("writeup.role")}</dt>
          <dd class="meta-name">{writeup.role[lang]}</dd>
        </div>
        <div class="spec-cell">
          <dt class="meta">{t("work.stack")}</dt>
          <dd class="meta-name">
            <StackLine names={project.stack} />
          </dd>
        </div>
        {(project.repoUrl || project.liveUrl || project.videoUrl) && (
          <div class="spec-cell">
            <dt class="meta">{t("work.links")}</dt>
            <dd class="spec-links">
              {project.repoUrl && (
                <BracketLink
                  href={project.repoUrl}
                  external
                  me={false}
                  newTabLabel={t("nav.newTab")}
                >
                  {t("work.code")}
                </BracketLink>
              )}
              {project.liveUrl && (
                <BracketLink
                  href={project.liveUrl}
                  external
                  me={false}
                  newTabLabel={t("nav.newTab")}
                >
                  {t("work.live")}
                </BracketLink>
              )}
              {project.videoUrl && (
                <BracketLink
                  href={project.videoUrl}
                  external
                  me={false}
                  newTabLabel={t("nav.newTab")}
                >
                  {t("work.video")}
                </BracketLink>
              )}
            </dd>
          </div>
        )}
      </dl>
    </div>
  </header>

  <div class="writeup-body tone-paper px-gutter py-joint sm:px-6 lg:px-12 lg:py-joint-lg">
    <div class="shell writeup-layout">
      {/* On lg, the chapters as a sticky index beside the reading column. */}
      <nav class="writeup-toc" aria-label={t("writeup.toc")}>
        <p class="meta writeup-toc-label">{t("writeup.toc")}</p>
        <ol class="writeup-toc-list">
          {writeup.chapters.map((chapter, c) => (
            <li>
              <a
                href={`#chapter-${c + 1}`}
                class="writeup-toc-link"
                data-toc-link
              >
                {chapter.heading[lang]}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="writeup-main">
        {writeup.chapters.map((chapter, c) => (
          <section class="chapter" aria-labelledby={`chapter-${c + 1}`}>
            <header class="chapter-head">
              <p
                class="meta flex items-center gap-2.5 tabular-nums"
                aria-hidden="true"
                data-reveal
              >
                <Diamond size={9} />
                {two(c + 1)}
              </p>
              <h2
                id={`chapter-${c + 1}`}
                class="chapter-title type-display-sm"
                data-reveal
              >
                {chapter.heading[lang]}
              </h2>
            </header>

            <div class="chapter-body">
              {group(body(chapter.blocks)).map((block, b) => {
                if (block.type === "aside")
                  return (
                    <div class="chapter-aside" data-reveal>
                      <Plate
                        lang={lang}
                        block={block.plate}
                        number={figures.get(block.plate) ?? 0}
                        bare
                      />
                      <div class="chapter-aside-text">
                        {block.text.map((item) =>
                          item.type === "list" ? (
                            <ul class="tick-list chapter-list">
                              {item.items[lang].map((line) => (
                                <li>
                                  <span>
                                    {emphasis(line).map((part) =>
                                      part.strong ? (
                                        <strong>{part.text}</strong>
                                      ) : (
                                        part.text
                                      )
                                    )}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          ) : (
                            <p class="chapter-p type-body">
                              {emphasis(item.text[lang]).map((part) =>
                                part.strong ? (
                                  <strong>{part.text}</strong>
                                ) : (
                                  part.text
                                )
                              )}
                            </p>
                          )
                        )}
                      </div>
                    </div>
                  )
                if (block.type === "carousel")
                  return (
                    <Carousel
                      lang={lang}
                      slides={block.slides.map((slide) => ({
                        block: slide,
                        number: figures.get(slide) ?? 0,
                      }))}
                    />
                  )
                if (block.type === "p")
                  return (
                    <p
                      class:list={[
                        "chapter-p",
                        b === 0 ? "chapter-lead type-lead" : "type-body",
                      ]}
                      data-reveal
                    >
                      {emphasis(block.text[lang]).map((part) =>
                        part.strong ? <strong>{part.text}</strong> : part.text
                      )}
                    </p>
                  )
                // Each item's text sits in one span, so the tick's grid sees a single cell.
                if (block.type === "list")
                  return (
                    <ul class="tick-list chapter-list" data-reveal="items">
                      {block.items[lang].map((item) => (
                        <li>
                          <span>
                            {emphasis(item).map((part) =>
                              part.strong ? (
                                <strong>{part.text}</strong>
                              ) : (
                                part.text
                              )
                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )
                if (block.type === "figure" || block.type === "clip")
                  return (
                    <Plate
                      lang={lang}
                      block={block}
                      number={figures.get(block) ?? 0}
                    />
                  )
                if (block.type === "diagram")
                  return (
                    <figure class="plate-wide" data-reveal>
                      <div class="diagram">
                        <picture>
                          <source
                            media="(width >= 40rem)"
                            srcset={`${block.src}-wide-${lang}.svg`}
                            width={block.wide.width}
                            height={block.wide.height}
                          />
                          <img
                            class="diagram-img"
                            src={`${block.src}-tall-${lang}.svg`}
                            width={block.tall.width}
                            height={block.tall.height}
                            alt={block.alt[lang]}
                            loading="lazy"
                            decoding="async"
                          />
                        </picture>
                        <button
                          type="button"
                          class="diagram-zoom"
                          aria-label={`${t("writeup.zoom")}: ${t("writeup.figure")} ${two(figures.get(block) ?? 0)}`}
                          data-zoom="image"
                          data-zoom-src={`${block.src}-wide-${lang}.svg`}
                          data-zoom-alt={block.alt[lang]}
                        />
                      </div>
                      <figcaption class="plate-caption">
                        <span class="meta tabular-nums">
                          {t("writeup.figure")} {two(figures.get(block) ?? 0)}
                        </span>
                        <span class="meta-name">{block.caption[lang]}</span>
                      </figcaption>
                    </figure>
                  )
                return (
                  <dl class="sheet rule-rows" data-reveal="rows">
                    {block.rows.map((row) => (
                      <div class="sheet-row">
                        <dt class="meta-name sheet-name" data-build>
                          {row.name}
                        </dt>
                        <dd class="type-body sheet-why" data-build>
                          {row.why[lang]}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  {/* Back on ink: where this entry sits in the list. */}
  <nav
    class="writeup-nav px-gutter py-section sm:px-6 lg:px-12 lg:py-section-lg"
    aria-label={t("nav.work")}
  >
    <div class="shell">
      <p class="meta writeup-updated" data-reveal>
        {updated}
      </p>
      <ul class="writeup-nav-row" data-reveal="items">
        <li>
          <BracketLink href={allWork}>{t("writeup.all")}</BracketLink>
        </li>
        {previous && (
          <li>
            <BracketLink href={previous.href}>
              {t("writeup.previous")}: {previous.title}
            </BracketLink>
          </li>
        )}
        {next && (
          <li class="writeup-nav-next">
            <BracketLink href={next.href} icon="→">
              {t("writeup.next")}: {next.title}
            </BracketLink>
          </li>
        )}
      </ul>
    </div>
  </nav>
  {/* One lightbox for the page: a plate's button fills it and opens it. */}
  <dialog class="lightbox" aria-label={t("writeup.zoom")} data-lightbox>
    <button
      type="button"
      class="lightbox-close meta"
      data-lightbox-close
      aria-label={t("writeup.close")}
    >
      <span aria-hidden="true">[</span>
      <span>{t("writeup.close")}</span>
      <span aria-hidden="true">]</span>
    </button>
    <div class="lightbox-stage" data-lightbox-stage></div>
  </dialog>
</article>

<script>
  // The index marks the chapter being read: the last one whose top has
  // passed the upper third of the screen.
  function initToc() {
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ]
    if (!links.length) return
    const chapters = links
      .map((a) => document.querySelector(a.hash)?.closest("section"))
      .filter((el): el is HTMLElement => !!el)
    const update = () => {
      const line = innerHeight / 3
      let current = 0
      chapters.forEach((ch, i) => {
        if (ch.getBoundingClientRect().top <= line) current = i
      })
      links.forEach((a, i) => a.toggleAttribute("aria-current", i === current))
      links[current]?.setAttribute("aria-current", "true")
    }
    update()
    addEventListener("scroll", update, { passive: true })
  }

  // Clips loop like GIFs, but only load and play while on screen. With
  // reduced motion they stay on their poster, with controls to play them.
  function initClips() {
    const clips = [
      ...document.querySelectorAll<HTMLVideoElement>("[data-clip]"),
    ]
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      for (const v of clips) v.controls = true
      return
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement
          if (isIntersecting) v.play().catch(() => {})
          else v.pause()
        }
      },
      { threshold: 0.25 }
    )
    for (const v of clips) io.observe(v)
  }

  // A plate's button opens it larger: the image at full size, or the clip
  // with controls. Escape, the close button or a click outside closes it.
  function initLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]")
    if (!dialog) return
    const stage = dialog.querySelector<HTMLElement>("[data-lightbox-stage]")!
    document.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLElement>("[data-zoom]")
      if (!button) return
      const { zoom, zoomSrc = "", zoomAlt = "" } = button.dataset
      if (zoom === "image") {
        const img = document.createElement("img")
        img.src = zoomSrc
        img.alt = zoomAlt
        stage.replaceChildren(img)
      } else {
        const video = document.createElement("video")
        video.muted = true
        video.loop = true
        video.playsInline = true
        video.controls = true
        video.autoplay = true
        video.setAttribute("aria-label", zoomAlt)
        video.poster = `${zoomSrc}.webp`
        for (const [ext, type] of [
          ["webm", "video/webm"],
          ["mp4", "video/mp4"],
        ] as const) {
          const source = document.createElement("source")
          source.src = `${zoomSrc}.${ext}`
          source.type = type
          video.append(source)
        }
        stage.replaceChildren(video)
      }
      dialog.showModal()
    })
    dialog
      .querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => dialog.close())
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || e.target === stage) dialog.close()
    })
    dialog.addEventListener("close", () => stage.replaceChildren())
  }

  initToc()
  initClips()
  initLightbox()
</script>

<style>
  .writeup-open,
  .writeup-nav {
    position: relative;
    isolation: isolate;
    background-color: var(--color-ink);
  }

  /*
   * ── Opening: a cover spread ──
   * Copy on the left, the cover on the right, the facts on one line under
   * both. Below lg everything stacks: copy, cover, facts.
   */
  .writeup-masthead {
    display: grid;
    gap: var(--spacing-row-lg) 1.5rem;
  }

  .writeup-copy {
    display: grid;
    align-content: start;
  }

  .writeup-kicker {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    color: var(--title-color);
  }

  .writeup-title {
    margin-top: var(--spacing-head-sm);
    color: var(--title-color);
  }

  .writeup-lead {
    max-width: 34rem;
    margin-top: var(--spacing-inner);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .writeup-cover :global(.writeup-cover-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
  }

  .writeup-cover {
    position: relative;
  }

  /* A screenshot cover is a button too; its mark shows on hover and focus. */
  .cover-zoom {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0.75rem;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: var(--color-ice);
    cursor: zoom-in;
  }

  .cover-zoom-icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.6rem;
    border-radius: 50%;
    background-color: color-mix(in oklab, var(--color-ink) 70%, transparent);
    opacity: 0;
    transition: opacity var(--duration-micro) ease;
  }

  .cover-zoom:hover .cover-zoom-icon,
  .cover-zoom:focus-visible .cover-zoom-icon {
    opacity: 1;
  }

  .cover-zoom:focus-visible {
    outline: 1px solid var(--color-ice);
    outline-offset: 3px;
  }

  @media (hover: none) {
    .cover-zoom-icon {
      opacity: 0.85;
    }
  }

  /* ── The facts, on one ruled line ── */
  .writeup-spec {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-row) 1.5rem;
    padding-top: var(--spacing-inner);
    border-top: 1px solid var(--rule);
  }

  .spec-cell {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .spec-cell dd {
    color: var(--title-color);
    text-wrap: pretty;
  }

  .spec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-block: -0.5rem;
  }

  @media (width >= 64rem) {
    .writeup-masthead {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }

    .writeup-copy {
      grid-column: 1 / 6;
    }

    .writeup-cover {
      grid-column: 6 / 13;
    }

    .writeup-spec {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /*
   * ── Chapters: one reading column ──
   * Text, headings, lists and sheets share a centred 42rem column; plates
   * step out to 60rem. On lg a run of plates sits in pairs across that
   * wider measure instead of one under another.
   */
  .chapter + .chapter {
    margin-top: var(--spacing-row);
  }

  .chapter-head {
    display: grid;
    gap: 0.75rem;
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: var(--spacing-inner);
  }

  .chapter-title {
    color: var(--title-color);
  }

  .chapter-body {
