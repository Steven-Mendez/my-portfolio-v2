---
/**
 * A project's write-up, laid out like a blog post. On ink, a centred
 * masthead: kicker (Work, track number, reading time), the project's name
 * as the h1, the lead, and under a hairline the spec row (year, role,
 * stack, links). Then, on paper, one centred 42rem reading column: each
 * chapter's number and heading sit in the column above its blocks.
 * Screenshots are plates that step out to 60rem; on lg a run of plates
 * sits in pairs. Plates are numbered in reading order across the page.
 * The last row, back on ink, points to the neighbouring write-up and back
 * to the list.
 *
 * Motion hooks are the shared ones: data-reveal on blocks, `items` on
 * lists, `rows` + data-build on the spec sheets, data-draw on the rule.
 */
import { Picture } from "astro:assets"
import BracketLink from "@/components/hero/BracketLink.astro"
import Diamond from "@/components/hero/Diamond.astro"
import StackLine from "@/components/sections/StackLine.astro"
import { projects } from "@/data/projects"
import {
  readingMinutes,
  writeupPath,
  writeups,
  type Block,
  type Writeup,
} from "@/data/writeups"
import { formatMonth } from "@/i18n/dates"
import type { Lang } from "@/i18n/ui"
import { emphasis, fill, getLocalizedPath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Lang
  writeup: Writeup
}

const { lang, writeup } = Astro.props
const t = useTranslations(lang)

const position = projects.findIndex((p) => p.slug === writeup.slug)
if (position < 0) throw new Error(`No project for write-up: ${writeup.slug}`)
const project = projects[position]!
// The track number in the Work list, so the watermark matches the list.
const index = String(position + 1).padStart(2, "0")
const two = (n: number) => String(n).padStart(2, "0")

const note = fill(t("writeup.readingTime"), {
  min: readingMinutes(writeup, lang),
})
const updated = fill(t("writeup.updated"), {
  date: formatMonth(writeup.updated, lang),
})

// Figures are numbered across the page in reading order.
const figures = new Map<Block, number>()
for (const chapter of writeup.chapters)
  for (const block of chapter.blocks)
    if (block.type === "figure" || block.type === "clip")
      figures.set(block, figures.size + 1)

// Neighbours in the order of the Work list.
const order = projects
  .map((p) => p.slug)
  .filter((slug) => writeups.some((w) => w.slug === slug))
const at = order.indexOf(writeup.slug)
const neighbour = (slug: string | undefined) =>
  slug
    ? {
        title: projects.find((p) => p.slug === slug)!.title,
        href: getLocalizedPath(lang, writeupPath(slug)),
      }
    : undefined
const previous = neighbour(order[at - 1])
const next = neighbour(order[at + 1])
const allWork = `${getLocalizedPath(lang).replace(/\/?$/, "/")}#work`
---

<article class="writeup" aria-labelledby="writeup-title">
  <header class="writeup-open px-gutter pt-36 pb-section sm:px-6 lg:px-12 lg:pt-40">
    <div class="dots-layer" aria-hidden="true"></div>
    <div class="shell writeup-masthead">
      {/* An article's masthead: what it is and how long, the title, the lead. */}
      <p class="meta writeup-kicker" data-reveal>
        <Diamond size={9} />
        <span>
          {t("nav.work")} {index}
        </span>
        <span aria-hidden="true">·</span>
        <span>{note}</span>
      </p>
      <h1 id="writeup-title" class="writeup-title type-display" data-reveal>
        {project.title}
      </h1>
      <p class="writeup-lead type-lead" data-reveal>
        {writeup.lead[lang]}
      </p>

      {/* The spec row: the facts of the project, in the hero's cells. */}
      <dl class="writeup-spec" data-reveal="items">
        <div class="spec-cell">
          <dt class="meta">{t("writeup.year")}</dt>
          <dd class="meta-name tabular-nums">{project.year}</dd>
        </div>
        <div class="spec-cell">
          <dt class="meta">{t("writeup.role")}</dt>
          <dd class="meta-name">{writeup.role[lang]}</dd>
        </div>
        <div class="spec-cell">
          <dt class="meta">{t("work.stack")}</dt>
          <dd class="meta-name">
            <StackLine names={project.stack} />
          </dd>
        </div>
        {(project.repoUrl || project.liveUrl) && (
          <div class="spec-cell">
            <dt class="meta">{t("work.links")}</dt>
            <dd class="spec-links">
              {project.repoUrl && (
                <BracketLink
                  href={project.repoUrl}
                  external
                  me={false}
                  newTabLabel={t("nav.newTab")}
                >
                  {t("work.code")}
                </BracketLink>
              )}
              {project.liveUrl && (
                <BracketLink
                  href={project.liveUrl}
                  external
                  me={false}
                  newTabLabel={t("nav.newTab")}
                >
                  {t("work.live")}
                </BracketLink>
              )}
            </dd>
          </div>
        )}
      </dl>
    </div>
  </header>

  <div class="writeup-body tone-paper px-gutter py-section sm:px-6 lg:px-12 lg:py-section-lg">
    <div class="shell writeup-layout">
      {/* On lg, the chapters as a sticky index beside the reading column. */}
      <nav class="writeup-toc" aria-label={t("writeup.toc")}>
        <p class="meta writeup-toc-label">{t("writeup.toc")}</p>
        <ol class="writeup-toc-list">
          {writeup.chapters.map((chapter, c) => (
            <li>
              <a
                href={`#chapter-${c + 1}`}
                class="writeup-toc-link"
                data-toc-link
              >
                {chapter.heading[lang]}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="writeup-main">
        {writeup.chapters.map((chapter, c) => (
          <section class="chapter" aria-labelledby={`chapter-${c + 1}`}>
            <header class="chapter-head">
              <p
                class="meta flex items-center gap-2.5 tabular-nums"
                aria-hidden="true"
                data-reveal
              >
                <Diamond size={9} />
                {two(c + 1)}
              </p>
              <h2
                id={`chapter-${c + 1}`}
                class="chapter-title type-display-sm"
                data-reveal
              >
                {chapter.heading[lang]}
              </h2>
            </header>

            <div class="chapter-body">
              {chapter.blocks.map((block, b) => {
                if (block.type === "p")
                  return (
                    <p
                      class:list={[
                        "chapter-p",
                        b === 0 ? "chapter-lead type-lead" : "type-body",
                      ]}
                      data-reveal
                    >
                      {emphasis(block.text[lang]).map((part) =>
                        part.strong ? <strong>{part.text}</strong> : part.text
                      )}
                    </p>
                  )
                // Each item's text sits in one span, so the tick's grid sees a single cell.
                if (block.type === "list")
                  return (
                    <ul class="tick-list chapter-list" data-reveal="items">
                      {block.items[lang].map((item) => (
                        <li>
                          <span>
                            {emphasis(item).map((part) =>
                              part.strong ? (
                                <strong>{part.text}</strong>
                              ) : (
                                part.text
                              )
                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )
                if (block.type === "figure")
                  return (
                    <figure class="plate" data-reveal>
                      <Picture
                        src={block.image}
                        alt={block.alt[lang]}
                        formats={["avif", "webp"]}
                        fallbackFormat="jpg"
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 64rem) 42rem, calc(100vw - 2rem)"
                        loading="lazy"
                        decoding="async"
                        class="plate-img"
                      />
                      <figcaption class="plate-caption">
                        <span class="meta tabular-nums">
                          {t("writeup.figure")} {two(figures.get(block) ?? 0)}
                        </span>
                        <span class="meta-name">{block.caption[lang]}</span>
                      </figcaption>
                    </figure>
                  )
                if (block.type === "clip")
                  return (
                    <figure class="plate" data-reveal>
                      <video
                        class="plate-img plate-clip"
                        width={block.width}
                        height={block.height}
                        poster={`${block.src}.jpg`}
                        aria-label={block.alt[lang]}
                        muted
                        loop
                        playsinline
                        preload="none"
                        data-clip
                      >
                        <source src={`${block.src}.webm`} type="video/webm" />
                        <source src={`${block.src}.mp4`} type="video/mp4" />
                      </video>
                      <figcaption class="plate-caption">
                        <span class="meta tabular-nums">
                          {t("writeup.figure")} {two(figures.get(block) ?? 0)}
                        </span>
                        <span class="meta-name">{block.caption[lang]}</span>
                      </figcaption>
                    </figure>
                  )
                return (
                  <dl class="sheet rule-rows" data-reveal="rows">
                    {block.rows.map((row) => (
                      <div class="sheet-row">
                        <dt class="meta-name sheet-name" data-build>
                          {row.name}
                        </dt>
                        <dd class="type-body sheet-why" data-build>
                          {row.why[lang]}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>

  {/* Back on ink: where this entry sits in the list. */}
  <nav
    class="writeup-nav px-gutter py-section sm:px-6 lg:px-12 lg:py-section-lg"
    aria-label={t("nav.work")}
  >
    <div class="shell">
      <p class="meta writeup-updated" data-reveal>
        {updated}
      </p>
      <ul class="writeup-nav-row" data-reveal="items">
        <li>
          <BracketLink href={allWork}>{t("writeup.all")}</BracketLink>
        </li>
        {previous && (
          <li>
            <BracketLink href={previous.href}>
              {t("writeup.previous")}: {previous.title}
            </BracketLink>
          </li>
        )}
        {next && (
          <li class="writeup-nav-next">
            <BracketLink href={next.href} icon="→">
              {t("writeup.next")}: {next.title}
            </BracketLink>
          </li>
        )}
      </ul>
    </div>
  </nav>
</article>

<script>
  // The index marks the chapter being read: the last one whose top has
  // passed the upper third of the screen.
  function initToc() {
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ]
    if (!links.length) return
    const chapters = links
      .map((a) => document.querySelector(a.hash)?.closest("section"))
      .filter((el): el is HTMLElement => !!el)
    const update = () => {
      const line = innerHeight / 3
      let current = 0
      chapters.forEach((ch, i) => {
        if (ch.getBoundingClientRect().top <= line) current = i
      })
      links.forEach((a, i) => a.toggleAttribute("aria-current", i === current))
      links[current]?.setAttribute("aria-current", "true")
    }
    update()
    addEventListener("scroll", update, { passive: true })
  }

  // Clips loop like GIFs, but only load and play while on screen. With
  // reduced motion they stay on their poster, with controls to play them.
  function initClips() {
    const clips = [
      ...document.querySelectorAll<HTMLVideoElement>("[data-clip]"),
    ]
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      for (const v of clips) v.controls = true
      return
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement
          if (isIntersecting) v.play().catch(() => {})
          else v.pause()
        }
      },
      { threshold: 0.25 }
    )
    for (const v of clips) io.observe(v)
  }

  initToc()
  initClips()
</script>

<style>
  .writeup-open,
  .writeup-nav {
    position: relative;
    isolation: isolate;
    background-color: var(--color-ink);
  }

  /* ── Masthead: centred, like an article's opening ── */
  .writeup-masthead {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .writeup-kicker {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem 0.75rem;
    color: var(--title-color);
  }

  .writeup-title {
    max-width: 52rem;
    margin-top: var(--spacing-head-sm);
    color: var(--title-color);
    text-wrap: balance;
  }

  .writeup-lead {
    max-width: 38rem;
    margin-top: var(--spacing-inner);
    color: var(--text-muted);
    text-wrap: balance;
  }

  /* ── Spec row ── */
  .writeup-spec {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-row) 1.5rem;
    width: 100%;
    max-width: 60rem;
    margin-top: var(--spacing-row-lg);
    padding-top: var(--spacing-inner);
    border-top: 1px solid var(--rule);
    text-align: left;
  }

  .spec-cell {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .spec-cell dd {
    color: var(--title-color);
    text-wrap: pretty;
  }

  .spec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-block: -0.5rem;
  }

  @media (width >= 64rem) {
    .writeup-spec {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /*
   * ── Chapters: one reading column ──
   * Text, headings, lists and sheets share a centred 42rem column; plates
   * step out to 60rem. On lg a run of plates sits in pairs across that
   * wider measure instead of one under another.
   */
  .chapter + .chapter {
    margin-top: var(--spacing-row-lg);
  }

  .chapter-head {
    display: grid;
    gap: 0.75rem;
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: var(--spacing-inner);
  }

  .chapter-title {
    color: var(--title-color);
  }

  .chapter-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--spacing-inner);
  }

  .chapter-body > * {
    grid-column: 1 / -1;
    justify-self: center;
    width: 100%;
    max-width: 42rem;
  }

  .chapter-body > .plate {
    max-width: none;
  }

  .chapter-lead {
    color: var(--title-color);
  }

  .chapter-p strong {
    font-weight: 500;
    color: var(--title-color);
  }

  .chapter-list strong {
    font-weight: 500;
    color: var(--title-color);
  }

  /* ── Plates ── */
  .plate {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    margin-block: 1rem;
  }

  .plate :global(.plate-img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .plate-caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 1rem;
    align-items: baseline;
    color: var(--text-muted);
  }

  .plate-caption .meta {
    color: var(--title-color);
  }

  /* ── Spec sheets ── */
  .sheet {
    margin-block: 0.75rem;
  }

  .sheet-row {
    display: grid;
    gap: 0.5rem;
    padding-block: var(--spacing-inner);
  }

  .sheet-name {
    color: var(--title-color);
  }

  .sheet-why {
    color: var(--text-muted);
  }

  @media (width >= 40rem) {
    .sheet-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 0 1.5rem;
    }

    .sheet-name {
      padding-top: 0.2em;
    }
  }

  @media (width >= 64rem) {
    .chapter + .chapter {
      margin-top: var(--spacing-section);
    }

    .chapter-body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .chapter-body > .plate:has(+ .plate),
    .chapter-body > .plate + .plate {
      grid-column: auto;
    }
  }

  /*
   * ── Index + reading column ──
   * Below lg the index is hidden and the column fills the shell. On lg the
   * shell is three tracks: the sticky index, the 42rem column, and an
   * empty track as wide as the first, so the column stays centred.
   */
  .writeup-toc {
    display: none;
  }

  @media (width >= 64rem) {
    .writeup-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 42rem) minmax(0, 1fr);
      column-gap: 3rem;
    }

    .writeup-main {
      grid-column: 2;
    }

    .writeup-toc {
      display: block;
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h, 3.75rem) + 2.5rem);
      max-width: 15rem;
    }
  }

  .writeup-toc-label {
    color: var(--text-muted);
  }

  .writeup-toc-list {
    display: grid;
    gap: 0.25rem;
    margin-top: 1rem;
  }

  .writeup-toc-link {
    display: block;
    padding-block: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--text-muted);
    transition: color var(--duration-micro, 0.15s) ease;
  }

  .writeup-toc-link:hover,
  .writeup-toc-link:focus-visible,
  .writeup-toc-link[aria-current="true"] {
    color: var(--title-color);
  }

  .chapter {
    scroll-margin-top: calc(var(--header-h, 3.75rem) + 2rem);
  }

  .plate-clip {
    background: var(--color-ink);
  }

  /* ── Closing nav ── */
  .writeup-updated {
    margin-bottom: var(--spacing-inner);
  }

  .writeup-nav-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-top: var(--spacing-inner);
    border-top: 1px solid var(--rule);
  }

  .writeup-nav-row :global(.bracket-link) {
    font-size: var(--text-body);
    letter-spacing: 0.04em;
  }

  .writeup-nav-next {
    margin-left: auto;
  }

  /* Below lg the links are touch targets: 44px tall at least. */
  @media (width < 64rem) {
    .writeup-nav-row :global(.bracket-link),
    .spec-links :global(.bracket-link) {
      min-height: 2.75rem;
      align-items: center;
    }
  }
</style>
