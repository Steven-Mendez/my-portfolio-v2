---
/**
 * One plate of a write-up: a screenshot (`figure`) or a silent loop
 * (`clip`), with its number and caption always underneath. A portrait clip
 * (a phone recording) keeps a phone's width. Plates have rounded corners,
 * like the opening's cover, and open larger in the page's lightbox: a
 * button over the media carries what the lightbox needs to show.
 */
import { getImage, Picture } from "astro:assets"
import type { Block } from "@/data/writeups"
import type { Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"

type PlateBlock = Extract<Block, { type: "figure" | "clip" }>

interface Props {
  lang: Lang
  block: PlateBlock
  /** Position in the page's figure numbering. */
  number: number
  /** Inside a carousel or beside text: the wrapper reveals it. */
  bare?: boolean
}

const { lang, block, number, bare = false } = Astro.props
const t = useTranslations(lang)
const label = `${t("writeup.figure")} ${String(number).padStart(2, "0")}`
const portrait = block.type === "clip" && block.height > block.width

// The lightbox's image: the source at its own size, as WebP.
const full =
  block.type === "figure"
    ? await getImage({
        src: block.image,
        format: "webp",
        width: Math.min(block.image.width, 2400),
      })
    : undefined
---

<figure
  class:list={["plate", portrait && "plate--portrait"]}
  data-reveal={bare ? undefined : true}
>
  <div class="plate-media">
    {block.type === "figure" ? (
      <Picture
        src={block.image}
        alt={block.alt[lang]}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[720, 1080, 1440]}
        sizes="(min-width: 64rem) 42rem, calc(100vw - 2rem)"
        loading="lazy"
        decoding="async"
        class="plate-img"
      />
    ) : (
      <video
        class="plate-img plate-clip"
        width={block.width}
        height={block.height}
        poster={`${block.src}.webp`}
        aria-label={block.alt[lang]}
        muted
        loop
        playsinline
        preload="none"
        data-clip
      >
        <source src={`${block.src}.webm`} type="video/webm" />
        <source src={`${block.src}.mp4`} type="video/mp4" />
      </video>
    )}
    <button
      type="button"
      class="plate-zoom"
      aria-label={`${t("writeup.zoom")}: ${label}`}
      data-zoom={block.type === "figure" ? "image" : "clip"}
      data-zoom-src={block.type === "figure" ? full!.src : block.src}
      data-zoom-alt={block.alt[lang]}
    >
      <svg
        class="plate-zoom-icon"
        viewBox="0 0 12 12"
        width="12"
        height="12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M7.5 1.5h3v3M10.5 1.5 7 5M4.5 10.5h-3v-3M1.5 10.5 5 7"></path>
      </svg>
    </button>
  </div>
  <figcaption class="plate-caption">
    <span class="meta tabular-nums">{label}</span>
    <span class="meta-name">{block.caption[lang]}</span>
  </figcaption>
</figure>

<style>
  .plate {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    margin: 0;
  }

  .plate-media {
    position: relative;
  }

  .plate :global(.plate-img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
  }

  .plate-clip {
    background: var(--color-ink);
  }

  /* The whole media is the button; its mark shows on hover and focus. */
  .plate-zoom {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0.75rem;
    border: 0;
    border-radius: 0.75rem;
    background: transparent;
    color: var(--color-ice);
    cursor: zoom-in;
  }

  .plate-zoom-icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.6rem;
    border-radius: 50%;
    background-color: color-mix(in oklab, var(--color-ink) 70%, transparent);
    opacity: 0;
    transition: opacity var(--duration-micro) ease;
  }

  .plate-zoom:hover .plate-zoom-icon,
  .plate-zoom:focus-visible .plate-zoom-icon {
    opacity: 1;
  }

  .plate-zoom:focus-visible {
    outline: 1px solid var(--title-color);
    outline-offset: 3px;
  }

  /* No hover on touch: the mark stays, quietly. */
  @media (hover: none) {
    .plate-zoom-icon {
      opacity: 0.85;
    }
  }

  .plate-caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 1rem;
    align-items: baseline;
    color: var(--text-muted);
  }

  .plate-caption .meta {
    color: var(--title-color);
  }

  /* A phone recording: a phone's width, centred when it stands alone. */
  .plate--portrait {
    width: 100%;
    max-width: 20rem;
    justify-self: center;
  }
</style>
